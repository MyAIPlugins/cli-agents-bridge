{
  "_comment": "Reference defaults for cli-agents-bridge. Source of truth at runtime is internal/config.DefaultConfig() — keep this file in sync. Users can copy this to ~/.claude/cli-agents-bridge/config.json and override fields.",
  "data_dir": "~/.claude/cli-agents-bridge",
  "stale_seconds": 300,
  "poll_interval_ms": 1000,
  "max_blocking_seconds": 540,
  "max_inbox_size": 100,
  "max_message_bytes": 65536,
  "retention_days": 7,
  "heartbeat_tick_ms": 30000,
  "auto_gc_hours": 24,
  "dedup_window_seconds": 10,
  "mcp_grant_ttl_minutes": 480,
  "mcp_next_max_wait_seconds": 40,
  "mcp_next_default_wait_seconds": 25,
  "mcp_scan_budget_seconds": 5,
  "mcp_child_timeout_seconds": 20,
  "mcp_max_result_bytes": 24576,
  "findings_stale_days": 7
}
