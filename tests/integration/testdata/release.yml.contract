name: Release

on:
  push:
    tags:
      - 'v*'

permissions:
  contents: write

jobs:
  goreleaser:
    name: GoReleaser
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0          # goreleaser needs full tag history
      - uses: actions/setup-go@v5
        with:
          go-version-file: go.mod   # same toolchain as the gate — the release binaries
                                    # must not be built by a Go the gate never ran
          cache: true
      # THE TAG IS CHECKED HERE AND NOWHERE ELSE, because this is the only job
      # where a tag exists by construction: it runs on `push: tags`.
      #
      # Not in ci.yml, and not from `git describe`. That checkout is shallow and
      # carries no tags at all — and the Makefile's line (`--always`, stderr
      # discarded) does NOT fail without them: it returns a bare SHA that looks
      # like a good value. A guard built on it would be red on every run, or be
      # made conditional, and a conditional tag check is the silent green.
      #
      # Before goreleaser rather than after: the point is to not publish a
      # release whose plugin manifest names a different version than the binary
      # shipped beside it, which is how the last one went out.
      #
      # EVERY LINE OF THIS FILE IS UNDER CONTRACT, not just this step. Six ways
      # of disarming the guard were found and five of them leave a step that
      # still reads correctly: commenting the env out, moving it onto a later
      # step, adding continue-on-error, reordering past goreleaser, or wrapping
      # the command so it cannot fail. None is visible to an assertion that
      # looks for a step by name, and all are visible to an exact comparison of
      # the whole file.
      #
      # AND IT ASKS FOR THE VERDICT, NOT THE EXIT CODE. `go test -run` on a name
      # that selects nothing prints "ok … [no tests to run]" and exits 0, so an
      # exit code cannot tell "the guard passed" from "the guard never ran" —
      # and anything that removes the guard from the binary (a build tag, a
      # renamed file) produces exactly the second while looking like the first.
      # The grep is the line that separates them. The log goes to mktemp rather
      # than into the checkout because goreleaser refuses a dirty tree, and a
      # guard that breaks the release it is guarding would get deleted.
      - name: the tag must match the plugin manifest
        env:
          @@ENV@@: ${{ github.ref_name }}
        run: |
          log="$(mktemp)"
          go test -run '^@@TEST@@$' -count=1 -v ./tests/integration/ > "$log" 2>&1 || { cat "$log"; exit 1; }
          grep -q '^--- PASS: @@TEST@@' "$log" || { echo "the tag guard was NOT executed"; cat "$log"; exit 1; }

      - name: GoReleaser
        uses: goreleaser/goreleaser-action@v6
        with:
          # PINNED, not a range, and this is a correction rather than a
          # precaution: .goreleaser.yml already uses `formats:` and
          # `format_overrides[].formats`, which are the >= 2.6 spelling. A
          # moving `~> v2` could therefore have broken a release on a day
          # nobody touched the repository — the same shape as
          # `go-version: stable`, which did exactly that to the gate on 11
          # August.
          version: 'v2.18.1'
          args: release --clean
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
